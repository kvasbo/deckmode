[Unit]
Description=Stream Deck to MQTT controller
After=network-online.target
Wants=network-online.target
# Never give up: the broker or the deck may come back whenever.
StartLimitIntervalSec=0

[Service]
User=deckmode
Group=deckmode
EnvironmentFile=/etc/deckmode/env
ExecStart=/usr/local/bin/deckmode --config /etc/deckmode/config.yaml
Restart=on-failure
RestartSec=5
# Logs go to journald: journalctl -u deckmode

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
